+/*
+ *  Generic fadd/fsub/fmul/fdiv for every single/double combination of the
+ *  destination and both sources (the hand-written ones above only cover
+ *  some). Index: td | t2 << 1 | t1 << 2.
+ */
+#define	FP_GEN(NAME, OP, TD, T1, T2, ISDIV)				\
+X(NAME)									\
+{									\
+	struct ieee_float_value f1, f2;					\
+	uint64_t a = reg(ic->arg[1]), b = reg(ic->arg[2]), r;		\
+	if (T1) a = (a << 32) + reg(ic->arg[1] + 4);			\
+	if (T2) b = (b << 32) + reg(ic->arg[2] + 4);			\
+	if (cpu->cd.m88k.cr[M88K_CR_PSR] & M88K_PSR_SFD1) {		\
+		SYNCH_PC;						\
+		cpu->cd.m88k.fcr[M88K_FPCR_FPECR] = M88K_FPECR_FUNIMP;	\
+		m88k_exception(cpu, M88K_EXCEPTION_SFU1_PRECISE, 0);	\
+		return;							\
+	}								\
+	ieee_interpret_float_value(a, &f1, T1 ? IEEE_FMT_D : IEEE_FMT_S); \
+	ieee_interpret_float_value(b, &f2, T2 ? IEEE_FMT_D : IEEE_FMT_S); \
+	if (ISDIV && f2.f == 0) {					\
+		SYNCH_PC;						\
+		cpu->cd.m88k.fcr[M88K_FPCR_FPECR] = M88K_FPECR_FDVZ;	\
+		m88k_exception(cpu, M88K_EXCEPTION_SFU1_PRECISE, 0);	\
+		return;							\
+	}								\
+	r = ieee_store_float_value(f1.f OP f2.f,			\
+	    TD ? IEEE_FMT_D : IEEE_FMT_S);				\
+	if (TD) {							\
+		reg(ic->arg[0]) = r >> 32;				\
+		reg(ic->arg[0] + 4) = r;				\
+	} else								\
+		reg(ic->arg[0]) = r;					\
+}
+
+#define	FP_GEN_ALL(OPNAME, OP, ISDIV)					\
+	FP_GEN(OPNAME##_g0, OP, 0, 0, 0, ISDIV)				\
+	FP_GEN(OPNAME##_g1, OP, 1, 0, 0, ISDIV)				\
+	FP_GEN(OPNAME##_g2, OP, 0, 0, 1, ISDIV)				\
+	FP_GEN(OPNAME##_g3, OP, 1, 0, 1, ISDIV)				\
+	FP_GEN(OPNAME##_g4, OP, 0, 1, 0, ISDIV)				\
+	FP_GEN(OPNAME##_g5, OP, 1, 1, 0, ISDIV)				\
+	FP_GEN(OPNAME##_g6, OP, 0, 1, 1, ISDIV)				\
+	FP_GEN(OPNAME##_g7, OP, 1, 1, 1, ISDIV)
+
+FP_GEN_ALL(fadd, +, 0)
+FP_GEN_ALL(fsub, -, 0)
+FP_GEN_ALL(fmul, *, 0)
+FP_GEN_ALL(fdiv, /, 1)
+
+#define	FP_TAB(OPNAME) { instr(OPNAME##_g0), instr(OPNAME##_g1),	\
+	instr(OPNAME##_g2), instr(OPNAME##_g3), instr(OPNAME##_g4),	\
+	instr(OPNAME##_g5), instr(OPNAME##_g6), instr(OPNAME##_g7) }
+
+/*  Map the (iword >> 5) & 0x3f precision field to a table index, or -1.  */
+static int fp_gen_index(uint32_t iword)
+{
+	int f = (iword >> 5) & 0x3f;
+	if (f & ~0x15)
+		return -1;		/*  extended precision: not on 88100  */
+	return (f & 1) | ((f >> 2) & 1) << 1 | ((f >> 4) & 1) << 2;
+}
