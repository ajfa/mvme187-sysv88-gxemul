 static void write_byte(struct osiop_data *d, struct cpu *cpu, uint32_t addr, uint8_t byte)
 {
+	/*  DMA into a page that may hold translated code (a program being
+	    paged in over another one): drop those translations.  */
+	if (d->last_inval_page != (addr & 0xfffff000) + 1) {
+		d->last_inval_page = (addr & 0xfffff000) + 1;
+		cpu->invalidate_code_translation(cpu, addr & 0xfffff000,
+		    INVALIDATE_PADDR);
+	}
+
 	if (d->last_host_page == NULL ||
 	    d->last_phys_page != (addr & 0xfffff000)) {
 		d->last_phys_page = addr & 0xfffff000;
@@ -237,6 +266,12 @@
