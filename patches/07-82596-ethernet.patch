+/*
+ *  net_dns_synth_ptr():
+ *
+ *  Old resolvers (e.g. SVR4's libsocket gethostbyname) insist on a reverse
+ *  lookup of every address they get, and give up when there is no PTR
+ *  record, which is common today. For answers relayed from the gateway's
+ *  nameserver: turn "no such PTR for a.b.c.d" into ip-a-b-c-d.nat.
+ *  Returns the (possibly new) length of the DNS message in buf.
+ */
+static int net_dns_synth_ptr(unsigned char *buf, int len, int bufsize)
+{
+	int pos = 12, qend, i, nlab = 0, rcode, n;
+	int octet[4];
+	char name[64];
+	unsigned char *p;
+
+	if (len < 12 || !(buf[2] & 0x80) || (buf[2] & 0x78) != 0)
+		return len;
+	rcode = buf[3] & 0x0f;
+	if ((buf[4] << 8 | buf[5]) != 1 || (buf[6] << 8 | buf[7]) != 0 ||
+	    (rcode != 0 && rcode != 3))
+		return len;
+
+	/*  Question name: d.c.b.a.in-addr.arpa  */
+	while (pos < len && buf[pos] != 0) {
+		int l = buf[pos];
+		if (l > 63 || pos + 1 + l > len)
+			return len;
+		if (nlab < 4) {
+			int v = 0;
+			if (l < 1 || l > 3)
+				return len;
+			for (i = 0; i < l; i++) {
+				if (buf[pos + 1 + i] < '0' || buf[pos + 1 + i] > '9')
+					return len;
+				v = v * 10 + buf[pos + 1 + i] - '0';
+			}
+			octet[3 - nlab] = v;
+		} else if (nlab == 4) {
+			if (l != 7 || strncasecmp((char *)buf + pos + 1,
+			    "in-addr", 7) != 0)
+				return len;
+		} else if (nlab == 5) {
+			if (l != 4 || strncasecmp((char *)buf + pos + 1,
+			    "arpa", 4) != 0)
+				return len;
+		}
+		nlab ++;
+		pos += 1 + l;
+	}
+	if (nlab != 6 || pos + 5 > len)
+		return len;
+	qend = pos + 1 + 4;
+	if ((buf[pos + 1] << 8 | buf[pos + 2]) != 12)		/*  PTR  */
+		return len;
+
+	snprintf(name, sizeof(name), "ip-%d-%d-%d-%d.nat",
+	    octet[0], octet[1], octet[2], octet[3]);
+	n = strlen(name);
+	if (qend + 12 + n + 2 > bufsize)
+		return len;
+
+	/*  Answer: c00c, PTR, IN, ttl 60, rdata = labels of name.  */
+	p = buf + qend;
+	*p++ = 0xc0; *p++ = 0x0c;
+	*p++ = 0; *p++ = 12;
+	*p++ = 0; *p++ = 1;
+	*p++ = 0; *p++ = 0; *p++ = 0; *p++ = 60;
+	*p++ = 0; *p++ = n + 2;
+	{
+		/*  "ip-a-b-c-d" label, then "nat", then root.  */
+		char *dot = strchr(name, '.');
+		int l1 = dot - name;
+		*p++ = l1;
+		memcpy(p, name, l1);
+		p += l1;
+		*p++ = 3;
+		memcpy(p, "nat", 3);
+		p += 3;
+		*p++ = 0;
+	}
+
+	buf[3] = (buf[3] & 0xf0);		/*  rcode = NOERROR  */
+	buf[6] = 0; buf[7] = 1;			/*  ancount = 1  */
+	buf[8] = 0; buf[9] = 0;			/*  nscount = 0  */
+	buf[10] = 0; buf[11] = 0;		/*  arcount = 0  */
+	return p - buf;
+}
