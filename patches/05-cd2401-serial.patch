+static int clmpcc_trace;
+
+/*
+ *  Interrupt context, as seen in STK after an interrupt acknowledge:
+ *  0x81 receive, 0x80 transmit, 0x01 modem, 0 none. Entered when the
+ *  PCC2 hands out an SCC vector, left on a write to REOIR/TEOIR/MEOIR.
+ */
+static int clmpcc_context;
+
+/*
+ *  The acknowledge also loads CAR with the interrupting channel (always 0
+ *  here) and saves the old CAR, which the EOI write puts back. SVR4/88
+ *  relies on it; 187Bug may leave CAR on another channel (no "ioi" run).
+ */
+static unsigned char *clmpcc_car;
+static unsigned char clmpcc_saved_car;
+
+void clmpcc_iack(int pcc2_vector)
+{
+	int old = clmpcc_context;
+
+	switch (pcc2_vector) {
+	case PCC2V_SCC_RX:
+	case PCC2V_SCC_RXE:	clmpcc_context = 0x81; break;
+	case PCC2V_SCC_TX:	clmpcc_context = 0x80; break;
+	case PCC2V_SCC_M:	clmpcc_context = 0x01; break;
+	default:		return;
+	}
+	if (clmpcc_car != NULL && old == 0) {
+		clmpcc_saved_car = *clmpcc_car;
+		*clmpcc_car = 0;
+	}
+}
+
+static void clmpcc_eoi(void)
+{
+	if (clmpcc_car != NULL && clmpcc_context != 0)
+		*clmpcc_car = clmpcc_saved_car;
+	clmpcc_context = 0;
+}
