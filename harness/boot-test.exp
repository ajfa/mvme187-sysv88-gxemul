#!/usr/bin/expect -f
# boot-test.exp: boot the prepared disk, log in as root, run a few commands, shut down.
# Environment: GXEMUL, ROM, DISK, GXEMUL_NVRAM as for prepare-disk.exp.
set timeout 2400
set env(GXEMUL_EXIT_ON_HALT) 1
spawn $env(GXEMUL) -q -Q -e mvme187 -d $env(DISK) 0xff800000:0:0:$env(ROM) 0:0:0:$env(ROM)
expect {
	"Autoboot in progress" { exp_continue }
	-re {Console Login: $} { }
	timeout { puts "\n*** no login prompt"; exit 1 }
	eof { puts "\n*** GXemul exited"; exit 1 }
}
set timeout 120
send "root\r"
expect {
	"Password:" { send "\r"; exp_continue }
	-re {TERM = \([^)]*\) } { send "vt100\r"; exp_continue }
	-re {# $} { }
}
foreach cmd {"uname -a" "df" "ping gateway"} {
	send "$cmd\r"
	expect {
		-re {# $} { }
		timeout { puts "\n*** timeout on: $cmd"; exit 1 }
	}
}
send "cd /; sync; shutdown -y -g0 -i0\r"
set timeout 300
expect {
	"powering down" { puts "\n*** shut down" }
	timeout { puts "\n*** no shutdown"; exit 1 }
}
expect eof
puts "\n*** GXemul exited with [lindex [wait] 3]"
